#!/bin/sh
### BEGIN INIT INFO
# Provides: kudzu-bs-analytics
# Required-Start: $remote_fs $syslog
# Required-Stop: $remote_fs $syslog
# Default-Start: 5
# Default-Stop: 0 6
# Short-Description: Kudzu Basic Station Analytics
### END INIT INFO
set -eu
BINARY=/usr/bin/basicstation-analytics
PIDFILE=/run/kudzu-bs-analytics/pid
CONFIGURATION_FILE=/etc/kudzu-bs-analytics.conf
LOG_FILE=
EXTRA_ARGS=
[ ! -f /etc/default/kudzu-bs-analytics ] || . /etc/default/kudzu-bs-analytics
pid() { [ ! -f "$PIDFILE" ] || cat "$PIDFILE"; }
alive() {
    process_id=$(pid)
    case "$process_id" in ''|*[!0-9]*) return 1;; esac
    executable=$(readlink "/proc/$process_id/exe" 2>/dev/null || true)
    executable=${executable% (deleted)}
    [ "$executable" = "$BINARY" ] && kill -0 "$process_id" 2>/dev/null
}
case "${1:-}" in
 start)
    [ "${DISABLE_KUDZU_BS_ANALYTICS:-yes}" != yes ] || exit 0
    alive && exit 0
    umask 027
    mkdir -p /run/kudzu-bs-analytics /run/basicstation
    chmod 0750 /run/kudzu-bs-analytics /run/basicstation
    set -- "$BINARY" --config "$CONFIGURATION_FILE"
    [ -z "$LOG_FILE" ] || set -- "$@" --log-file "$LOG_FILE"
    "$@" ${EXTRA_ARGS:-} &
    echo $! > "$PIDFILE"
    ;;
 stop)
    if alive; then kill "$(pid)"; while alive; do sleep 1; done; fi
    rm -f "$PIDFILE"
    ;;
 restart) "$0" stop; "$0" start;;
 *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1;;
esac

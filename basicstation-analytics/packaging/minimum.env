# Retention limits cover partial, queued and in-flight telemetry; not total RSS.
MAX_BATCHES=1
MAX_MESSAGES=1
MAX_BUFFER_BYTES=1024
PRE_IDENTITY_MAX_MESSAGES=0
SHUTDOWN_DEADLINE_MS=100
LOG_LEVEL=error
# Configure credentials/endpoints separately. No telemetry spool or log file.
SOCKET_RCVBUF_BYTES=1024
POLL_MAX_DATAGRAMS=1

# Supply pinned SDK paths explicitly; host libraries are never target inputs.
set(TOOLCHAIN_ROOT "" CACHE PATH "Pinned corecell SDK compiler root")
set(CMAKE_SYSROOT "" CACHE PATH "Target sysroot with gRPC, protobuf, OpenSSL")
if(NOT TOOLCHAIN_ROOT OR NOT CMAKE_SYSROOT)
  message(FATAL_ERROR "corecell requires TOOLCHAIN_ROOT and CMAKE_SYSROOT from the SDK manifest")
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_C_COMPILER "${TOOLCHAIN_ROOT}/bin/arm-linux-gnueabihf-gcc")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_ROOT}/bin/arm-linux-gnueabihf-g++")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
